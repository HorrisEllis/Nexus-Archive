      {
        "uuid": "393e16f8-566c-44ca-b189-914977916b8b",
        "type": "fix-log",
        "domain": "system",
        "body": "Built lib/gap-priority.js -- composite gap priority, bottom-up/architecture-first, reusing real KERNELS vitality data, loom real dependency graph, and diagnostic-engines real tension/SNR. Found and fixed 3 real bugs while building it: a wrong wire field name (w.to vs w.to_hook_id, silently returning empty data every time), a cli/ path regex missing the start-of-string case, and requiring autopilot.js live had real ungated side effects (a live ResourceMonitor + event fan-in) -- switched to a small static duplicate of the real vitality data instead.",
        "source": "cortex",
        "severity": "high",
        "status": "closed",
        "causedBy": null,
        "dedup_key": "fix::cortex::1786964861394",
        "occurrences": 1,
        "detectedAt": 1786964861394,
