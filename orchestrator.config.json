{
  "_comment": "NEXUS Orchestrator runtime config — edit here, never in orchestrator.js",
  "openUIOnBoot": true,
  "openTerminalOnBoot": false,
  "uiURL": "http://127.0.0.1:9000",
  "openEmergeOnBoot": false,
  "emerge": {
    "autoOpen": false,
    "port": 4242
  },
  "ports": {
    "orchestrator": 9000,
    "bridge": 9999,
    "cortex": 3748,
    "guardian": 7820,
    "architect": 3747,
    "idearium": 4800,
    "emerge": 4242,
    "ollama": 11434
  },
  "raid": {
    "tickMs": 3000,
    "healthPollMs": 10000,
    "executionTreeEnabled": true,
    "isDecisionAuthority": true,
    "localFirst": true,
    "localFirstFailThreshold": 3,
    "agents": {
      "ollama":            { "enabled": true },
      "guardian-claude":   { "enabled": true },
      "guardian-chatgpt":  { "enabled": true },
      "claude":            { "enabled": true },
      "chatgpt":           { "enabled": true },
      "gemini":            { "enabled": true },
      "perplexity":        { "enabled": true }
    }
  },
  "heal": {
    "_comment": "Single source of truth for self-healing. Replaces NEXUS_HEAL_DRY and NEXUS_FORGE_APPLY env vars — those are now ignored if this block is present.",
    "mode": "live",
    "maxAttempts": 3,
    "requireRaidApproval": true,
    "autoHealSeverity": ["low", "medium"],
    "escalateSeverity": ["high", "critical"]
  },
  "state": {
    "persistPath": "data/NEXUS_STATE.json",
    "saveIntervalMs": 10000,
    "resumeOnBoot": true
  }
}
