envelope: 1
uuid: nexus-export-schema-worksurface
type: schema
id: worksurface
context: lib/node-schemas — shared node-type schema registry
intent: null
summary: null
system: null
tags: []
exported_at: 1789350000000
source: nexus.lib.node-export
payload:
  status: REAL
  source: >-
    §MCO20 2026-09-13 — James: "cos type or template for a Work surface query or operating table,
    with line count, chunks, parse and chunk tool." Grounded in lib/work-surface.js's real
    createWorkSurface() — the operating table for one large file inside a COS compartment's working
    memory. Built to close a real, confirmed gap: lib/project-compartment.js's buildSeedFromPayload()
    silently truncates any file over 4000 bytes, which is exactly the "massive repo" case this
    closes — chunk boundaries cover the WHOLE file, no gaps, no silent drops.
  fields:
    uuid:
      type: string
      required: true
      description: real, unique id for this work surface
    path:
      type: string
      required: true
      description: the real, absolute file path this work surface describes
    lineCount:
      type: number
      required: true
      description: real total line count, as an editor would count it
    byteCount:
      type: number
      required: true
      description: real UTF-8 byte size of the file at parse time
    chunkCount:
      type: number
      required: true
      description: real number of chunks covering the whole file
    chunks:
      type: array
      required: true
      description: >-
        real, non-overlapping [{index, startLine, endLine, lineCount, contentHash}] covering the
        whole file — chunk CONTENT is never stored here, only metadata; use
        lib/work-surface.js's getChunkContent() to re-derive one chunk's real content on demand
    createdAt:
      type: number
      required: true
      description: real creation timestamp — a work surface is a point-in-time snapshot of a file's shape, not a live view
