{
  "id": "clearglass-accounts-v1",
  "version": "0.1.0",
  "namespace": "clearglass-accounts",
  "port": 7704,
  "transport": {
    "http": "http://127.0.0.1:7704",
    "guardian": "http://127.0.0.1:7820"
  },
  "resources": {
    "accounts.list": {
      "endpoints": {
        "list": {
          "method": "GET",
          "path": "/api/accounts"
        }
      }
    },
    "accounts.add": {
      "endpoints": {
        "add": {
          "method": "POST",
          "path": "/api/accounts",
          "params": [
            "provider",
            "label",
            "sessionRef"
          ]
        }
      }
    },
    "accounts.remove": {
      "endpoints": {
        "remove": {
          "method": "DELETE",
          "path": "/api/accounts",
          "params": [
            "id"
          ]
        }
      }
    },
    "accounts.usage": {
      "endpoints": {
        "usage": {
          "method": "GET",
          "path": "/api/accounts/usage",
          "params": [
            "id"
          ]
        }
      }
    },
    "accounts.usage-report": {
      "endpoints": {
        "report-usage": {
          "method": "POST",
          "path": "/api/accounts/usage-report",
          "params": [
            "id",
            "percent",
            "source"
          ]
        }
      }
    },
    "accounts.route": {
      "endpoints": {
        "route": {
          "method": "POST",
          "path": "/api/accounts/route",
          "params": [
            "provider"
          ]
        }
      }
    }
  }
}