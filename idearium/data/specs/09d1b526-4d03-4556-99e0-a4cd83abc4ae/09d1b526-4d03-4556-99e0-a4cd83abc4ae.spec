      console.log(`  ${bold(s.message)}`);
      console.log(`  ${dim('snr')} ${snrColor(s.snr)} (${delta})  ${dim('ideas')} ${s.ideasCount}  ${dim('gaps')} ${s.gapCount}`);
      if (s.phaseMap) {
        const phases = Object.entries(s.phaseMap).filter(([,n])=>n>0).map(([p,n])=>`${phaseColor(p)}:${n}`).join('  ');
