  console.log(`  ${ok(`Uptime         ${Math.floor(h.uptime)}s`)}`);

  // Check memory tables
  const tables = ['cortex_memory', 'memory_index', 'crystals', 'gaps', 'failures',
                  'bep_patterns', 'intent_nodes', 'seam_records', 'lattice_nodes'];
