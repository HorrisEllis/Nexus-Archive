    'seam list':        'seam list [--verified] [--n 20]',
    'seam show':        'seam show <uuid>',
    'intent list':      'intent list [--n 20] [--sort callCount|successRate|surpriseScore]',
    'intent show':      'intent show <uuid>',
    'intent search':    'intent search <term>',
