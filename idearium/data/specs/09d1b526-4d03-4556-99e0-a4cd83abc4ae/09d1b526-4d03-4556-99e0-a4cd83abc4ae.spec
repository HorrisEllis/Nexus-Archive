  _pill.onclick = () => {}; // passive mode removed — nothing to toggle
  document.body.appendChild(_pill);
  updatePill();
}

// ── Init ──────────────────────────────────────────────────────────────────────
async function init() {
  await dbOpen().catch(() => { _log('err','IDB failed — degraded mode'); });
  _injectWidget();
  connect();
