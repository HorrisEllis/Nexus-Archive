    ['GET',    ['api','events'],          'events.log'],
    ['GET',    ['api','ideas'],           'idea.list'],
    ['POST',   ['api','ideas'],           'idea.create'],
    // §BUILT 2026-09-03 — James: "idearium needs to use data folder. no
