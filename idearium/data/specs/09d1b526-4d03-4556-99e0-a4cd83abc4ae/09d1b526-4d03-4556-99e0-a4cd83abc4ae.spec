  if (!recentFails.length) {
    console.log(`  ${ok('No recent failures')}`);
  } else {
    for (const f of recentFails) {
      console.log(`  ${ts(f)}  ${pad(f.source, 20)} ${c('red', String(f.error || '').slice(0, 60))}`);
    }
  }
