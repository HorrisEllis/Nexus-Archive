     thought) and from the Spec Library ("+ new spec"). -->
<div class="modal-overlay" id="new-spec-modal">
  <div class="modal">
    <div class="modal-title">+ New Spec</div>
    <div class="field-group">
      <div class="field-label">name <span class="req">*</span></div>
