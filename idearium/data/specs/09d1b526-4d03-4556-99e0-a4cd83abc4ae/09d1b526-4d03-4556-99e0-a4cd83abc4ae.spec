    const ev=(r.evidenceFull||[]).map(e=>`<div class="ev"><b>${esc(e.kind)}</b> — ${esc(e.detail)}<br>↳ ${esc(e.where)}</div>`).join('');
    const acts = st==='proposed'
      ? `<div class="act"><input id="n-${esc(r.slug)}" placeholder="note (required to reject)">
