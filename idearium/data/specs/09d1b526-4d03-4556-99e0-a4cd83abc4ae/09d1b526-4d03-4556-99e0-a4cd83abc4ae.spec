        let d = '';
        const req = http.get(
          'http://127.0.0.1:' + PORT + '/api/recall',
          res => {
            res.on('data', c => { d += c; });
            res.on('end', () => {
              try { resolve(JSON.parse(d)); } catch(e) { reject(e); }
