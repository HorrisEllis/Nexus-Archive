      const ip = await new Promise((resolve, reject) => {
        const req = (url.startsWith('https') ? https : http).get(url, { timeout: timeoutMs }, res => {
          let d = '';
          res.on('data', c => d += c);
          res.on('end', () => resolve(d.trim()));
