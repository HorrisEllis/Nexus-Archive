// ── Constants ─────────────────────────────────────────────────────────────────
const NCP_URL     = 'http://127.0.0.1:7820';
const NCP_CHANNEL = `${NCP_URL}/channel`;
const NCP_RESULT  = `${NCP_URL}/result`;
const NCP_HB      = `${NCP_URL}/heartbeat`;
const CORTEX_URL  = 'http://127.0.0.1:3748';
const ORCH_URL    = 'http://127.0.0.1:9000';
