// ── IndexedDB Kernel — §US-02 ─────────────────────────────────────────────────
// Three stores: requests (queue), sessions (UUID chain), artifacts (hash→UUID).
// Replay authority lives here. Nothing else owns replay. §US-03.
const IDB_NAME    = 'nexus_guardian_chatgpt';
const IDB_VERSION = 1;
