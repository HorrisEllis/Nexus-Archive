});

test('scoreDefault rewards staying under token budget, penalizes exceeding it', () => {
  const efficient = scoreDefault({ output: { a: 1 }, tokenBudget: 100 });
  const bloated = scoreDefault({ output: { a: 'x'.repeat(1000) }, tokenBudget: 100 });
