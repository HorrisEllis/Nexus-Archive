  "content": "  function filterString(p = _params) {\n    return [\n      `brightness(${p.brightness})`,\n      `contrast(${p.contrast})`,\n      `saturate(${p.saturation})`,\n      `hue-rotate(${p.hue}deg)`,\n      `blur(${p.blur}px)`,\n      `grayscale(${p.grayscale})`,\n      `invert(${p.invert})`,\n      `sepia(${p.sepia})`,\n    ].join(' ');\n  }\n"
