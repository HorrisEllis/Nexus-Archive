\n      LATTICE_THRESHOLD:  0.65   # minimum edge weight to cluster\n      PHASE_TRANSITIONS:  \"seed→expanding→tensioned→specced→building→complete\"\n\n  # ── AX-008 (foundation addendum v1.1.0) ────────────────────────────────────\n  # ✅ CLOSED 2026-06-29 — idearium/index.js's _broadcast() pushes every\n  # os.emit() to all SSE clients on GET /sse. copilot/server.js had an\n  # IDR_URL constant declared since at least v3 but never connected to it —\n  # scoped, never wired. Added _connectIdeariumStream() (same pattern as\n  # _connectCortexStream/_connectGuardianStream), wired into copilot's boot\n  # sequence, and added hooks/idearium.hooks.js's 4th entry\n  # (idearium-to-copilot, seam:idearium-copilot-bridge) so the wire is\n  # registry-visible, not just code. idea/project/lattice activity now\n  # reaches copilot live.\n","byteSize":1661,"createdAt":1788653036142,"updatedAt":1788653036148,"completedAt":1788653036148,"tags":["document-core","system","e2e-idearium"],"jobId":null,"dispatchDir":null,"structuralProfile":{"chars":1136,"structure":{"deps":0,"hookEvents":0,"failureModes":0},"constraints":{"invariantRefs":0},"structuralTotal":0}},{"uuid":"2729e7ab-1395-4154-98aa-bc267a2792ad","specUuid":"382a3442-220b-47e0-9e3c-3f98fbb98d10","chunkIdx":2,"sectionId":"document-events","sectionTitle":"document — events","sectionDesc":"auto-split from \"document\" (natural boundary: events)","comp_id":"idearium.spec-engine","seam_id":"idearium.spec-engine:v1:chunk:382a3442:document-events","contract_id":"spec-contract:382a3442:document-events:2729e7ab","filePath":"/home/claude/nexus-merged/idearium/data/specs/382a3442-220b-47e0-9e3c-3f98fbb98d10/02-document-events-2729e7ab.md","fileName":"02-document-events.md","status":"complete","agent":"import","agentModel":"import:.spec","attempts":1,"failureMode":null,"content":"<!-- imported: document → events -->\n\n\n  events:\n    emits:\n      - \"idearium.booted\"\n      - \"idearium.idea.created\"\n      - \"idearium.idea.phase_changed\"\n      - \"idearium.project.created\"\n      - \"idearium.project.spec_dropped\"\n      - \"idearium.project.build_started\"\n      - \"idearium.lattice.connected\"\n      - \"idearium.lattice.crystallised\"\n    handles:\n      - \"guardian.job.complete → artifact.store\"\n      - \"cortex.gap.found     → project.gap_attach\"\n      - \"spec.compile.complete → project.build_start\"\n","byteSize":928,"createdAt":1788653036142,"updatedAt":1788653036150,"completedAt":1788653036150,"tags":["document-events","system","e2e-idearium"],"jobId":null,"dispatchDir":null,"structuralProfile":{"chars":479,"structure":{"deps":0,"hookEvents":0,"failureModes":0},"constraints":{"invariantRefs":0},"structuralTotal":0}},{"uuid":"c1d53f9a-76c8-4281-98b8-6eaa14e6a3cc","specUuid":"382a3442-220b-47e0-9e3c-3f98fbb98d10","chunkIdx":3,"sectionId":"document-modules","sectionTitle":"document — modules","sectionDesc":"auto-split from \"document\" (natural boundary: modules)","comp_id":"idearium.spec-engine","seam_id":"idearium.spec-engine:v1:chunk:382a3442:document-modules","contract_id":"spec-contract:382a3442:document-modules:c1d53f9a","filePath":"/home/claude/nexus-merged/idearium/data/specs/382a3442-220b-47e0-9e3c-3f98fbb98d10/03-document-modules-c1d53f9a.md","fileName":"03-document-modules.md","status":"complete","agent":"import","agentModel":"import:.spec","attempts":1,"failureMode":null,"content":"<!-- imported: document → modules -->\n\n\n  modules:\n    - id: idea-store\n      description: \"CRUD for ideas. Phase management. JAA-backed.\"\n\n    - id: project-repo\n      description: >\n        Project manager. Accepts dropped zips via file-push router.\n        Watches for .spec files and queues them for build.\n        Links projects to ideas, specs, artifacts, gaps.\n\n    - id: lattice\n      description: >\n        Spatial engine integration. Builds resonance-weighted graph.\n        Nodes: ideas, specs, gaps, artifacts.\n        Edges: reinforced on every association (view, link, co-occurrence).\n        Connected-components clustering above weight threshold.\n        High-weight edges crystallise into long-term cortex memory.\n\n    - id: queue-listener\n      description: >\n        Watches for .spec files. On detect: validates, queues,\n        dispatches to spec-compiler via Guardian.\n","byteSize":1300,"createdAt":1788653036142,"updatedAt":1788653036152,"completedAt":1788653036152,"tags":["document-modules","system","e2e-idearium"],"jobId":null,"dispatchDir":null,"structuralProfile":{"chars":852,"structure":{"deps":0,"hookEvents":0,"failureModes":0},"constraints":{"invariantRefs":0},"structuralTotal":0}},{"uuid":"34fd9291-9718-4dc2-809e-be35aed9e9d1","specUuid":"382a3442-220b-47e0-9e3c-3f98fbb98d10","chunkIdx":4,"sectionId":"document-command-index","sectionTitle":"document — command_index","sectionDesc":"auto-split from \"document\" (natural boundary: command_index)","comp_id":"idearium.spec-engine","seam_id":"idearium.spec-engine:v1:chunk:382a3442:document-command-index","contract_id":"spec-contract:382a3442:document-command-index:34fd9291","filePath":"/home/claude/nexus-merged/idearium/data/specs/382a3442-220b-47e0-9e3c-3f98fbb98d10/04-document-command-index-34fd9291.md","fileName":"04-document-command-index.md","status":"complete","agent":"import","agentModel":"import:.spec","attempts":1,"failureMode":null,"content":"<!-- imported: document → command_index -->\n\n\n  command_index:\n    status: DONE       # verified 2026-09-03 -- GET /api/contract/live, 72 real endpoints, 72=72 against fresh grep\n    spec: \"docs/command-index-per-system.spec\"\n    note: \"idearium's existing routes array (72 entries) maps directly -- cheapest phase, exposure not extraction.\"\n","byteSize":775,"createdAt":1788653036142,"updatedAt":1788653036155,"completedAt":1788653036155,"tags":["document-command-index","system","e2e-idearium"],"jobId":null,"dispatchDir":null,"structuralProfile":{"chars":297,"structure":{"deps":0,"hookEvents":0,"fai