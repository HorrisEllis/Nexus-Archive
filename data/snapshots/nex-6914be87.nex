,"_rowId":75880,"_ts":1782041036925},{"uuid":"bcae8897-ea5e-47a7-884f-931502d5d1ba","type":"gap-loop.ecology","payload":{"total":2,"by_type":{"TEMPORAL":1,"CAUSAL":1},"by_status":{"needs_manual":1,"forge_failed":1},"critical_count":0,"temporal_accumulation":false,"causal_unresolved":1,"ecology_health":"nominal","topology_health":"nominal"},"source":"gap-loop","causedBy":null,"ts":1782041037052,"_rowId":75882,"_ts":1782041037052},{"uuid":"8cdf9d92-c069-4318-b5c7-3a1c4842dfba","type":"heartbeat.tick","payload":{"orchestrator":{"online":true,"latencyMs":4},"cortex":{"online":true,"latencyMs":3},"guardian":{"online":true,"latencyMs":1},"idearium":{"online":true,"latencyMs":0},"bridge":{"online":true,"latencyMs":0},"architect":{"online":true,"latencyMs":1},"emerge":{"online":false,"latencyMs":0},"diagnostic":{"online":true,"latencyMs":1}},"source":"heartbeat","causedBy":null,"ts":1782041037052,"_rowId":75883,"_ts":1782041037063},{"uuid":"941c66c0-6975-4c95-a20a-d8ac584312ce","type":"raid.health","payload":"{\"ollama\":{\"online\":true,\"fails\":0},\"guardian-claude\":{\"online\":true,\"fails\":0},\"guardian-chatgpt\":{\"online\":true,\"fails\":0},\"claude\":{\"online\":true,\"fails\":0},\"chatgpt\":{\"online\":true,\"fails\":0},\"gemini\":{\"online\":true,\"fails\":0},\"perplexity\":{\"online\":true,\"fails\":0}}","source":"raid","ts":1782041042067,"_rowId":75889,"_ts":1782041042067},{"uuid":"f6c2cdb3-a778-4343-8d1e-831cc19752ba","type":"raid.health","payload":"{\"ollama\":{\"online\":true,\"fails\":0},\"guardian-claude\":{\"online\":true,\"fails\":0},\"guardian-chatgpt\":{\"online\":true,\"fails\":0},\"claude\":{\"online\":true,\"fails\":0},\"chatgpt\":{\"online\":true,\"fails\":0},\"gemini\":{\"online\":true,\"fails\":0},\"perplexity\":{\"online\":true,\"fails\":0}}","source":"raid","ts":1782041042067,"_rowId":75890,"_ts":1782041042067},{"uuid":"dda6ab89-6acf-4754-8f08-254ebe5a1a85","type":"memory.observer.heartbeat","payload":{"provider":"chatgpt","sessionId":"chatgpt